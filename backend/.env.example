PORT=4000
CORS_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8001
PROCESSING_SERVICE_URL=http://127.0.0.1:8000
MONO_SECRET_KEY=
MONO_API_BASE=https://api.withmono.com

# Required for admin login and /admin/* routes. Use the SAME URI as processing/.env (Supabase) or local Docker:
# DATABASE_URL=postgresql://credra:credra@127.0.0.1:5433/credra
# DATABASE_URL=postgresql://postgres.xxx:PASSWORD@aws-0-....pooler.supabase.com:6543/postgres
# Optional: DATABASE_SSL=false disables TLS for local-only URLs.
# Remote DBs use TLS; default is permissive CA check (Supabase-friendly). For strict verification set:
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Admin JWT signing (set a long random string in production)
ADMIN_JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
# Set true when serving the API over HTTPS so admin cookies are Secure-only
ADMIN_COOKIE_SECURE=false

# Client dashboard/auth (for paying customers)
CLIENT_JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# Email (Resend) for OTP verification
RESEND_API_KEY=
# Optional: a verified sender, e.g. "CREDRA <no-reply@yourdomain.com>"
RESEND_FROM=

# Transfer-based subscription receiving details (used in the client UI)
BILLING_RECEIVING_BANK_NAME=GTBank
BILLING_RECEIVING_ACCOUNT_NUMBER=0558518751
BILLING_RECEIVING_ACCOUNT_NAME=Onoja William Bosworth
