# --- Local Docker (repo root: docker compose up -d postgres) ---
# DATABASE_URL=postgresql://credra:credra@127.0.0.1:5433/credra

# --- Local PostgreSQL (Windows installer, user/db credra) ---
# DATABASE_URL=postgresql://credra:credra@127.0.0.1:5432/credra

# --- Supabase (Dashboard → Project Settings → Database → Connection string → URI) ---
# Paste the full URI. Use Session mode if you pick the pooler. Example shape:
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Remote hosts get TLS automatically; only set DATABASE_SSLMODE=disable for odd tunnels.

DATABASE_URL=postgresql://credra:credra@127.0.0.1:5433/credra
